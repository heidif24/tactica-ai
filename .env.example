# Alpaca Paper Trading API Keys
# Get these from https://app.alpaca.markets/paper/dashboard/overview
# Never commit real keys. Copy this file to .env and fill in values.

ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# Optional: override base URLs (normally not needed)
# ALPACA_PAPER=true
